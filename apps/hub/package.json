{
  "name": "@orbis/hub",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore \"./data/**\" src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --clean --external better-sqlite3",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/node-ws": "^1.1.0",
    "@orbis/sdk": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.0.0",
    "bonjour-service": "^1.4.4",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "nanoid": "^5.1.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "satori": "^0.33.5",
    "semver": "^7.7.0",
    "tar": "^7.4.0",
    "zod": "^4.0.0",
    "@orbis/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/semver": "^7.7.0",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
