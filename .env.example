# Orbis hub configuration (all optional)
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# writable data dir (sqlite, installed modules, module data)
ORBIS_DATA_DIR=./apps/hub/data
# static web build to serve at /
ORBIS_WEB_DIR=./apps/web/out
# comma separated registry index urls
ORBIS_REGISTRIES=https://raw.githubusercontent.com/orbis-hub/registry/main/index.json
# extra CORS origins (capacitor + localhost dev are always allowed)
ORBIS_CORS_ORIGINS=
ORBIS_SESSION_DAYS=90
