{
  "id": "waste",
  "name": "Waste collection",
  "version": "0.1.0",
  "description": "When the bins have to go out. Finds your municipal schedule by address (MyMüll / Jumomind), reads an ical feed, or takes rules you type in. Reminds you the evening before.",
  "author": "orbis",
  "icon": "trash",
  "minHub": "0.1.0",
  "entry": {
    "server": "dist/server.js",
    "client": "dist/client.js"
  },
  "languages": [
    "en",
    "de"
  ],
  "eink": true,
  "widgets": [
    {
      "id": "next",
      "name": "Next collections",
      "description": "The next pickups as a list: bin, colour and when. Tomorrow's bin is highlighted.",
      "defaultSize": {
        "w": 3,
        "h": 3
      },
      "minSize": {
        "w": 2,
        "h": 2
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "title": "How many",
            "default": 4,
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    },
    {
      "id": "week",
      "name": "This week",
      "description": "Seven days as a strip with a coloured dot per pickup.",
      "defaultSize": {
        "w": 4,
        "h": 2
      },
      "minSize": {
        "w": 3,
        "h": 1
      }
    }
  ],
  "pages": [
    {
      "id": "waste",
      "name": "Waste collection",
      "icon": "trash"
    }
  ],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "reminderHour": {
        "type": "integer",
        "title": "Remind the evening before at (hour)",
        "default": 18,
        "minimum": 0,
        "maximum": 23
      },
      "lookaheadDays": {
        "type": "integer",
        "title": "Show pickups for (days)",
        "default": 28,
        "minimum": 7,
        "maximum": 120
      }
    }
  },
  "permissions": [
    "storage",
    "scheduler",
    "notifications",
    "network:fetch",
    "settings:read"
  ]
}
