{
  "id": "todo",
  "name": "Todo",
  "version": "0.1.0",
  "description": "Lists and tasks with due dates. A widget per list plus a full page.",
  "author": "orbis",
  "icon": "checkbox-on",
  "minHub": "0.1.0",
  "entry": { "server": "dist/server.js", "client": "dist/client.js" },
  "widgets": [
    {
      "id": "list",
      "name": "Todo list",
      "description": "Tasks of one list, quick add included.",
      "defaultSize": { "w": 4, "h": 5 },
      "minSize": { "w": 2, "h": 2 },
      "configSchema": {
        "type": "object",
        "properties": {
          "listId": { "type": "string", "title": "List id (empty = inbox)", "default": "" },
          "showDone": { "type": "boolean", "title": "Show completed", "default": false },
          "quickAdd": { "type": "boolean", "title": "Quick add field", "default": true }
        }
      }
    },
    {
      "id": "today",
      "name": "Due today",
      "description": "Everything due today or overdue, across lists.",
      "defaultSize": { "w": 3, "h": 4 },
      "minSize": { "w": 2, "h": 2 }
    }
  ],
  "pages": [{ "id": "tasks", "name": "Tasks", "icon": "checkbox-on" }],
  "permissions": ["storage"]
}
