{
  "id": "countdown",
  "name": "Countdown",
  "version": "0.1.3",
  "description": "Big number counting down to a date: vacation, birthday, deadline. Client-only, one widget per countdown.",
  "author": "orbis",
  "icon": "hourglass",
  "minHub": "0.1.0",
  "entry": {
    "client": "dist/client.js"
  },
  "widgets": [
    {
      "id": "countdown",
      "name": "Countdown",
      "defaultSize": {
        "w": 3,
        "h": 2
      },
      "minSize": {
        "w": 2,
        "h": 1
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "What",
            "placeholder": "vacation"
          },
          "date": {
            "type": "string",
            "title": "Date",
            "format": "date"
          },
          "time": {
            "type": "string",
            "title": "Time (optional)",
            "format": "time"
          },
          "yearly": {
            "type": "boolean",
            "title": "Repeats every year (birthdays)",
            "default": false
          },
          "icon": {
            "type": "string",
            "title": "Icon (pixelarticons name)",
            "default": "hourglass"
          },
          "showUnits": {
            "type": "string",
            "title": "Show",
            "enum": [
              "auto",
              "days",
              "weeks",
              "hours"
            ],
            "enumNames": [
              "auto",
              "days",
              "weeks + days",
              "hours"
            ],
            "default": "auto"
          }
        }
      }
    }
  ],
  "pages": [],
  "permissions": []
}
