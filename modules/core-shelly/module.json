{
  "id": "shelly",
  "name": "Shelly",
  "version": "0.1.7",
  "description": "Shelly relays and plugs straight over the local network, no cloud, no Home Assistant. Gen2+ RPC (Plus / Pro / Mini), Gen1 basic.",
  "author": "orbis",
  "icon": "plug",
  "minHub": "0.1.0",
  "languages": [
    "en",
    "de"
  ],
  "entry": {
    "server": "dist/server.js",
    "client": "dist/client.js"
  },
  "widgets": [
    {
      "id": "switch",
      "name": "Shelly switch",
      "description": "One relay with power draw.",
      "defaultSize": {
        "w": 2,
        "h": 2
      },
      "minSize": {
        "w": 1,
        "h": 1
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "title": "Device id (from the shelly page)"
          },
          "channel": {
            "type": "integer",
            "title": "Channel",
            "default": 0,
            "minimum": 0,
            "maximum": 3
          },
          "name": {
            "type": "string",
            "title": "Label"
          }
        }
      }
    },
    {
      "id": "power",
      "name": "Power overview",
      "description": "All shellys with their current watts.",
      "defaultSize": {
        "w": 3,
        "h": 3
      },
      "minSize": {
        "w": 2,
        "h": 2
      }
    }
  ],
  "pages": [
    {
      "id": "shelly",
      "name": "Shelly",
      "icon": "plug"
    }
  ],
  "permissions": [
    "network:fetch",
    "storage",
    "scheduler",
    "devices:read",
    "devices:claim"
  ],
  "discovery": {
    "mdns": [
      "_shelly._tcp"
    ],
    "vendor": [
      "Shelly"
    ],
    "hostname": "^shelly"
  }
}
