{
  "id": "weather",
  "name": "Weather",
  "version": "0.1.4",
  "description": "Current conditions and forecast from Open-Meteo. No API key needed.",
  "author": "orbis",
  "icon": "cloud-sun",
  "minHub": "0.1.0",
  "entry": {
    "server": "dist/server.js",
    "client": "dist/client.js"
  },
  "widgets": [
    {
      "id": "current",
      "name": "Current weather",
      "description": "Temperature, condition and a few details for a location.",
      "defaultSize": {
        "w": 3,
        "h": 3
      },
      "minSize": {
        "w": 2,
        "h": 2
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "title": "Location id (empty = default)",
            "default": ""
          },
          "details": {
            "type": "boolean",
            "title": "Show wind / humidity",
            "default": true
          }
        }
      }
    },
    {
      "id": "forecast",
      "name": "Forecast",
      "description": "Next days at a glance.",
      "defaultSize": {
        "w": 6,
        "h": 3
      },
      "minSize": {
        "w": 3,
        "h": 2
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "title": "Location id (empty = default)",
            "default": ""
          },
          "days": {
            "type": "integer",
            "title": "Days",
            "default": 5,
            "minimum": 2,
            "maximum": 7
          }
        }
      }
    }
  ],
  "pages": [
    {
      "id": "weather",
      "name": "Weather",
      "icon": "cloud-sun"
    }
  ],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "locations": {
        "type": "array",
        "title": "Locations",
        "description": "format: id=Name@lat,lon – e.g. home=Würzburg@49.79,9.95. the first one is the default."
      },
      "units": {
        "type": "string",
        "title": "Units",
        "enum": [
          "metric",
          "imperial"
        ],
        "default": "metric"
      },
      "refreshMinutes": {
        "type": "integer",
        "title": "Refresh every (minutes)",
        "default": 15,
        "minimum": 5,
        "maximum": 120
      }
    }
  },
  "permissions": [
    "network:fetch",
    "storage",
    "scheduler",
    "settings:read"
  ]
}
