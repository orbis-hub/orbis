{
  "id": "media",
  "name": "Media",
  "version": "0.1.6",
  "description": "Now playing, playback controls and device picker. Spotify today, more providers later.",
  "author": "orbis",
  "icon": "music",
  "minHub": "0.1.0",
  "entry": {
    "server": "dist/server.js",
    "client": "dist/client.js"
  },
  "widgets": [
    {
      "id": "now-playing",
      "name": "Now playing",
      "description": "Cover, track, progress, controls and the device it plays on.",
      "defaultSize": {
        "w": 4,
        "h": 4
      },
      "minSize": {
        "w": 2,
        "h": 2
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "showCover": {
            "type": "boolean",
            "title": "Cover art",
            "default": true
          },
          "showTitle": {
            "type": "boolean",
            "title": "Title & artist",
            "default": true
          },
          "showProgress": {
            "type": "boolean",
            "title": "Progress bar",
            "default": true
          },
          "showControls": {
            "type": "boolean",
            "title": "Playback controls",
            "default": true
          },
          "showDevice": {
            "type": "boolean",
            "title": "Device picker",
            "default": true
          },
          "showVolume": {
            "type": "boolean",
            "title": "Volume slider",
            "default": false
          },
          "showSearch": {
            "type": "boolean",
            "title": "Search bar (autocomplete)",
            "default": true
          },
          "searchTypes": {
            "type": "array",
            "title": "Search in (track, playlist, album, artist)",
            "default": [
              "track",
              "playlist",
              "album"
            ]
          },
          "layout": {
            "type": "string",
            "title": "Layout",
            "enum": [
              "auto",
              "horizontal",
              "vertical"
            ],
            "enumNames": [
              "auto (by size)",
              "horizontal",
              "vertical"
            ],
            "default": "auto"
          }
        }
      }
    },
    {
      "id": "devices",
      "name": "Playback devices",
      "description": "Pick where music plays.",
      "defaultSize": {
        "w": 3,
        "h": 3
      },
      "minSize": {
        "w": 2,
        "h": 2
      }
    }
  ],
  "pages": [
    {
      "id": "media",
      "name": "Media",
      "icon": "music"
    }
  ],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "spotifyClientId": {
        "type": "string",
        "title": "Spotify client id",
        "description": "from developer.spotify.com → your app. redirect uri must be <hub url>/api/m/media/spotify/callback – spotify accepts https or http://127.0.0.1 only"
      },
      "pollSeconds": {
        "type": "integer",
        "title": "Poll playback every (seconds)",
        "default": 10,
        "minimum": 5,
        "maximum": 60
      }
    }
  },
  "permissions": [
    "network:fetch",
    "storage",
    "scheduler"
  ],
  "publicPaths": [
    "/spotify/callback"
  ],
  "softDeps": [
    "home-assistant"
  ]
}
