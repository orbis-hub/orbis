{
  "id": "birthdays",
  "name": "Birthdays",
  "version": "0.1.7",
  "description": "People and their dates. Who is up next, how old they turn, a note so you remember the tea they like.",
  "author": "orbis",
  "icon": "cake",
  "minHub": "0.1.0",
  "languages": ["en", "de"],
  "entry": {
    "server": "dist/server.js",
    "client": "dist/client.js"
  },
  "widgets": [
    {
      "id": "upcoming",
      "name": "Upcoming birthdays",
      "defaultSize": {
        "w": 3,
        "h": 3
      },
      "minSize": {
        "w": 2,
        "h": 2
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "title": "How many",
            "default": 5,
            "minimum": 1,
            "maximum": 20
          },
          "showAge": {
            "type": "boolean",
            "title": "Show age",
            "default": true
          }
        }
      }
    }
  ],
  "pages": [
    {
      "id": "people",
      "name": "Birthdays",
      "icon": "cake"
    }
  ],
  "permissions": [
    "storage",
    "scheduler",
    "notifications"
  ]
}
